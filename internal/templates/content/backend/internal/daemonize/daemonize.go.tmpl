// Package daemonize provides a simple way to run background tasks.
package daemonize

import (
	"fmt"
	"log/slog"
	"time"
)

// Daemonize securely runs a long-lived function (daemon) concurrently
// in a goroutine.
func Daemonize(fn func(), name string, errorLogger *slog.Logger) {
	run(fn, "daemon", name, errorLogger)
}

// Task securely runs a one-shot function concurrently
// in a goroutine.
func Task(fn func(), name string, errorLogger *slog.Logger) {
	run(fn, "task", name, errorLogger)
}

// run executes a function securely in a goroutine by recovering any panics that
// the function might trigger.
// kind determines the kind of function that is being executed, e.g. `daemon` or `task`.
func run(fn func(), kind, name string, errorLogger *slog.Logger) {
	go func() {
		defer func() {
			if pv := recover(); pv != nil {
				pvString := fmt.Sprintf("%v", pv)
				errorLogger.Error(kind+" panicked, but was recovered", slog.String(kind, name), slog.String("panic_value", pvString))
			}
		}()

		fn()
	}()
}

func CalculateDurationTillNextRun(scheduledTime time.Time) time.Duration {
	now := time.Now()
	scheduledTimeToday := time.Date(
		now.Year(), now.Month(), now.Day(),
		scheduledTime.Hour(), scheduledTime.Minute(), 0, 0,
		now.Location(),
	)

	nextScheduledTime := scheduledTimeToday
	if scheduledTimeToday.Before(now) {
		nextScheduledTime = scheduledTimeToday.AddDate(0, 0, 1)
	}

	return nextScheduledTime.Sub(now)
}
